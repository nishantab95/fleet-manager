# Backend application
FLEET_ENVIRONMENT=development
FLEET_LOG_LEVEL=INFO
FLEET_DATABASE_URL=postgresql+psycopg://fleet:fleet@localhost:5432/fleet
FLEET_CORS_ALLOWED_ORIGINS=http://localhost:3000
FLEET_ALLOWED_HOSTS=*
FLEET_WEB_PUBLIC_BASE_URL=http://localhost:3000

# Authentication. Keep the provider unavailable until a real SMS provider is configured.
FLEET_PHONE_DEFAULT_REGION=
# Local pilot fixture only. The three role cards intentionally share this phone.
# FLEET_PILOT_DRIVER_PHONE=+919606743463
FLEET_OTP_PROVIDER=unavailable
FLEET_ENABLE_DEVELOPMENT_OTP=false
# For controlled local pilot only: set provider to pilot and provide these six-digit
# values in the gitignored .env file. Never set any pilot OTP material in production.
# DRIVER: 111111, SUPERVISOR: 222222, OWNER_ADMIN: 333333
# FLEET_PILOT_DRIVER_OTP=<local-driver-otp>
# FLEET_PILOT_SUPERVISOR_OTP=<local-supervisor-otp>
# FLEET_PILOT_OWNER_OTP=<local-owner-otp>
FLEET_OTP_TTL_SECONDS=300
FLEET_OTP_MAX_ATTEMPTS=5
FLEET_OTP_RESEND_COOLDOWN_SECONDS=60
FLEET_JWT_SIGNING_KEY=
FLEET_JWT_ISSUER=fleet-manager-api
FLEET_JWT_AUDIENCE=fleet-manager-client

# Local/pilot S3-compatible object storage. Compose publishes MinIO's internal
# 9000/9001 ports on MINIO_API_PORT/MINIO_CONSOLE_PORT below. Keep the endpoint
# and host-port variables aligned; replace local values through secret
# management before enabling a production profile.
FLEET_OBJECT_STORAGE_PROVIDER=unavailable  # set to s3 when MinIO/S3 is configured
FLEET_S3_ENDPOINT_URL=http://localhost:19000
FLEET_S3_REGION=us-east-1
FLEET_S3_BUCKET=fleet-local
FLEET_S3_ACCESS_KEY_ID=<local-minio-access-key>
FLEET_S3_SECRET_ACCESS_KEY=<local-minio-secret-key>
FLEET_EVIDENCE_MAX_BYTES=5000000
FLEET_EVIDENCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
FLEET_EVENT_FUTURE_SKEW_SECONDS=300
# Maximum accepted driver START/END odometer value; keep at most two decimals.
FLEET_MAX_ODOMETER_KM=10000000

# Local Driver QA web client. Disabled unless explicitly set in the web process.
# NEXT_PUBLIC_ENABLE_DRIVER_QA=false

# Local infrastructure only; replace through secret management in pilot/production.
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
MINIO_ROOT_USER=<local-minio-access-key>
MINIO_ROOT_PASSWORD=<local-minio-secret-key>
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
