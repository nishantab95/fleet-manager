# Backend application
FLEET_ENVIRONMENT=development
FLEET_LOG_LEVEL=INFO
FLEET_DATABASE_URL=postgresql+psycopg://fleet:fleet@localhost:5432/fleet
FLEET_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Authentication. Keep the provider unavailable until a real SMS provider is configured.
FLEET_PHONE_DEFAULT_REGION=
FLEET_OTP_PROVIDER=unavailable
FLEET_ENABLE_DEVELOPMENT_OTP=false
FLEET_OTP_TTL_SECONDS=300
FLEET_OTP_MAX_ATTEMPTS=5
FLEET_OTP_RESEND_COOLDOWN_SECONDS=60
FLEET_JWT_SIGNING_KEY=
FLEET_JWT_ISSUER=fleet-manager-api
FLEET_JWT_AUDIENCE=fleet-manager-client

# Local S3-compatible object storage (MinIO)
FLEET_OBJECT_STORAGE_PROVIDER=unavailable  # set to s3 when MinIO/S3 is configured
FLEET_S3_ENDPOINT_URL=http://localhost:9000
FLEET_S3_REGION=us-east-1
FLEET_S3_BUCKET=fleet-local
FLEET_S3_ACCESS_KEY_ID=minioadmin
FLEET_S3_SECRET_ACCESS_KEY=minioadmin
FLEET_EVIDENCE_MAX_BYTES=5000000
FLEET_EVIDENCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
FLEET_EVENT_FUTURE_SKEW_SECONDS=300

# Local infrastructure only; replace through secret management in production.
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
