# Copy to /etc/fleet-ai/restic.env, chmod 600, and replace each CHANGE_ME value.
# The repository must be independent of the VPS. Restic encrypts content before upload.
RESTIC_REPOSITORY=s3:https://CHANGE_ME_OFFSITE_S3_ENDPOINT/fleet-ai-production
RESTIC_PASSWORD_FILE=/etc/fleet-ai/restic-password
AWS_ACCESS_KEY_ID=CHANGE_ME_OFFSITE_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_OFFSITE_SECRET_KEY
AWS_DEFAULT_REGION=CHANGE_ME_REGION
