# Copy to /etc/fleet-ai/production.env on the VPS, chmod 600, and replace every
# CHANGE_ME value. This file is an example only and must never contain secrets.
FLEET_IMAGE_REGISTRY=ghcr.io/CHANGE_ME_OWNER
FLEET_IMAGE_TAG=0000000000000000000000000000000000000000
FLEET_TLS_EMAIL=ops@fleetaisystems.com

POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
# URL-encode reserved characters in the password used in this URL.
FLEET_DATABASE_URL=postgresql+psycopg://fleet:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/fleet

MINIO_ROOT_USER=CHANGE_ME_RANDOM_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_RANDOM_MINIO_ROOT_PASSWORD
FLEET_S3_BUCKET=fleet-evidence
FLEET_S3_REGION=us-east-1
FLEET_S3_ACCESS_KEY_ID=CHANGE_ME_RANDOM_APP_ACCESS_KEY
FLEET_S3_SECRET_ACCESS_KEY=CHANGE_ME_RANDOM_APP_SECRET_KEY

FLEET_AUTH_MODE=company_pin
FLEET_PHONE_DEFAULT_REGION=IN
FLEET_JWT_SIGNING_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_CHARACTERS
FLEET_LOG_LEVEL=INFO
FLEET_EVIDENCE_MAX_BYTES=5000000
FLEET_DATABASE_POOL_SIZE=5
FLEET_DATABASE_MAX_OVERFLOW=2
FLEET_DATABASE_POOL_TIMEOUT_SECONDS=10
FLEET_RATE_LIMIT_REQUESTS_PER_MINUTE=600
FLEET_AUTH_RATE_LIMIT_REQUESTS_PER_MINUTE=60
FLEET_RATE_LIMIT_MAX_CLIENTS=10000

FLEET_LEAD_DIR=/var/lib/fleet-ai/leads
FLEET_BACKUP_DIR=/var/backups/fleet-ai
